{
  "name": "home-desk-panel",
  "version": "0.1.0",
  "description": "Sidebar panel frontend for the Home Desk Home Assistant integration",
  "author": "Greminn",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "push": "node --env-file=.env scripts/dev/push.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "lit": "^3.3.3",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "prettier": "^3.3.3",
    "rollup": "^4.61.0",
    "tslib": "^2.8.0",
    "typescript": "^6.0.3"
  }
}
